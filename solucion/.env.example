# =============================================================================
# Reto 01 · Configuración por variables de entorno
#
# Copia este archivo a `.env` y ajusta lo que necesites:
#     cp .env.example .env
# `.env` está ignorado por git; ESTE archivo sí se versiona porque es la
# documentación ejecutable de cómo se configura la aplicación.
#
# Ninguna de estas variables se registra ni se devuelve por la API (PRD §8).
# =============================================================================

# ── Proveedor de lenguaje (PRD §6.1) ──
# ollama = local y sin claves (por defecto) · openai = cualquier API compatible
# con OpenAI · mock = guion fijo sin modelo, para demos y pruebas.
LLM_PROVIDER=ollama

# ── Ollama local ──
OLLAMA_HOST=http://localhost:11434

# Modelo del ciclo del agente. Recomendado con 16 GB de RAM o más:
#     ollama pull granite4.1:8b      (5.3 GB · español + tool calling + JSON)
# Alternativa más liviana si andas escaso de memoria:
#     ollama pull qwen3:4b-instruct  (2.5 GB · tool calling, pero menos fiable
#                                     siguiendo instrucciones condicionales)
OLLAMA_MODEL=granite4.1:8b

# Ventana de contexto. Medido en la prueba de extremo a extremo: el prompt
# (agent/prompt.md + el conocimiento del proceso) más los esquemas de las cinco
# herramientas ronda 4 179 tokens, y el valor por defecto de Ollama es 4 096, así
# que por debajo de 8192 la petición falla con "request exceeds the available
# context size".
OLLAMA_NUM_CTX=8192

# Razonamiento previo de los modelos híbridos (`think`). Déjalo comentado salvo
# que el modelo razonen: los modelos que no razonan rechazan el campo. Acepta
# true, false o el nivel low|medium|high|max.
# OLLAMA_THINK=false

# ── API compatible con OpenAI (solo si LLM_PROVIDER=openai) ──
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ── Servidor HTTP ──
PORT=3000
HOST=127.0.0.1

# ── Reproducibilidad (PRD §6.5) ──
# Fija la fecha de ejecución para que vencimientos y veredicto de firma no
# dependan del reloj; vacío = fecha del sistema.
# FECHA_EJECUCION=2026-01-02
# Repositorio de casos y soportes; vacío = ../fixtures/reto-01
# FIXTURES_DIR=
